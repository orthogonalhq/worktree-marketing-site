# Server-only Supabase configuration supplied by the Vercel integration.
LEADS_DB_SUPABASE_URL=
LEADS_DB_SUPABASE_SERVICE_ROLE_KEY=

# Optional defaults shown here for clarity.
SUPABASE_DEPLOY_TABLE=deploy_submissions
# Set a distinct secret in production to hash form-rate-limit keys.
LEADS_DB_RATE_LIMIT_SECRET="REDACTED_64_CHARACTER_HEX_SECRET"

# Private partner portal. Create a read-only Notion integration, share the
# Outbound Sales page tree with it, and keep these values server-only.
NOTION_PARTNER_PORTAL_TOKEN=
NOTION_PARTNER_PORTAL_PAGE_ID=3aad5a4c-f68c-81d7-ba48-e8f763836b7e
# Optional public launch mode. When set, the authenticated portal embeds this
# URL instead of reading through the Notion API.
PARTNER_PORTAL_NOTION_EMBED_URL=https://sparkling-mouse-7e2.notion.site/ebd/3aad5a4cf68c81d7ba48e8f763836b7e

# Shared launch password and an unrelated random secret of at least 32
# characters used to sign the HTTP-only partner session cookie.
PARTNER_PORTAL_PASSWORD=
PARTNER_PORTAL_SESSION_SECRET=
PARTNER_PORTAL_SESSION_DAYS=7
